---
// Products — terminal data table. One panel, one row per product,
// column header strip like a trading blotter. Collapses to stacked
// cards under 860px (see .ptable rules in global.css).
import { products, domain } from '../data/site';
---
<section class="band" id="products" aria-labelledby="products-h">
  <div class="shell">
    <div class="section-head">
      <div class="point">
        <span class="eyebrow"><span class="idx">PORTFOLIO</span>&nbsp;&nbsp;04 products · live onchain</span>
      </div>
      <h2 id="products-h">The stack we ship.</h2>
      <p class="sub">
        Framework, wallet, infra, and DEX — four products covering the full lifecycle of a
        token, from build to hook-powered pool. Every one of them is running in production today.
      </p>
    </div>

    <div class="ptable">
      <div class="ptable-head" aria-hidden="true">
        <span>#</span>
        <span>Product</span>
        <span>Class</span>
        <span>Chain</span>
        <span>Status</span>
        <span class="num">Metric</span>
        <span></span>
      </div>

      {products.map((p) => (
        <a class="prow" href={p.url} target="_blank" rel="noopener" style={`--acc:${p.accent}`}>
          <span class="pnum">{p.idx}</span>

          <div class="pmain">
            <h3 class="pname">{p.name}</h3>
            <p class="pdesc">{p.desc}</p>
            <div class="pfeats">
              {p.feats.map((f) => <span>{f}</span>)}
            </div>
          </div>

          <span class="pcat"><span class="lbl">Class</span>{p.cat}</span>
          <span class="pchain"><span class="lbl">Chain</span>{p.chain}</span>

          <span class="pstat">
            <span class={`st${p.status === 'LIVE' ? ' live' : ' beta'}`}>
              <span class="dot"></span>{p.status}
            </span>
          </span>

          <span class="pmetric">
            <b>{p.metric.v}</b>
            <span class="lbl">{p.metric.l}</span>
          </span>

          <span class="pgo">
            <span class="dom">{domain(p.url)}</span>
            <span class="arw" aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
