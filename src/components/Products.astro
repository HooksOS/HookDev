---
import { products, domain } from '../data/site';
---
<section class="band" id="products" aria-labelledby="products-h">
  <div class="shell">
    <div class="section-head">
      <div class="point"><span class="eyebrow"><span class="idx">01 / 05</span>&nbsp;&nbsp;Products</span></div>
      <h2 id="products-h">Five products, one hook stack.</h2>
    </div>

    <div class="pindex">
      {products.map((p) => (
        <article class="prow">
          <div class="pnum">{p.idx}</div>
          <div>
            <div class="pname">
              <span class="n">{p.name}</span>
              <span class={`st${p.status === 'LIVE' ? ' live' : ''}`}>{p.status}</span>
            </div>
            <div class="pmeta">{p.cat} · {p.chain}</div>
          </div>
          <div class="pdesc">{p.desc}</div>
          <div class="pright">
            <div class="pmetric">{p.metric.v}<span class="lbl">{p.metric.l}</span></div>
            <a class="plink" href={p.url} target="_blank" rel="noopener" aria-label={`${p.name} website`}>
              {domain(p.url)} <span class="arw" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
