---
import { products, domain } from '../data/site';
---
<section class="band" id="products" aria-labelledby="products-h">
  <div class="shell">
    <div class="section-head">
      <div class="point"><span class="eyebrow"><span class="idx">THE FORGE</span>&nbsp;&nbsp;05 products, live onchain</span></div>
      <h2 id="products-h">Everything we've built.</h2>
      <p class="sub">A full stack for hook-powered DeFi — framework, wallet, oracle, infra, and DEX. Each one shipping in production.</p>
    </div>

    <div class="pgrid">
      {products.map((p) => (
        <a class="pcard" href={p.url} target="_blank" rel="noopener" style={`--acc:${p.accent}`}>
          <div class="pcard-top">
            <span class="pnum">{p.idx}</span>
            <span class={`st${p.status === 'LIVE' ? ' live' : ''}`}>{p.status}</span>
          </div>

          <div class="pcard-body">
            <h3 class="pname">{p.name}</h3>
            <div class="pmeta">{p.cat} · {p.chain}</div>
            <p class="pdesc">{p.desc}</p>
          </div>

          <div class="pfeats">
            {p.feats.map((f) => <span>{f}</span>)}
          </div>

          <div class="pcard-foot">
            <span class="pmetric"><b>{p.metric.v}</b> {p.metric.l}</span>
            <span class="plink">{domain(p.url)} <span class="arw" aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
