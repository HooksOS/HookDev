---
import { services } from '../data/site';
---
<section class="band" id="services" aria-labelledby="svc-h">
  <div class="shell">
    <div class="section-head">
      <div class="point"><span class="eyebrow">Services</span></div>
      <h2 id="svc-h">Work with the studio.</h2>
    </div>

    <div class="svc-grid">
      {services.map((s) => (
        <article class="svc">
          <div class="k">{s.k}</div>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
          <div class="items">{s.items.map((i) => <span>{i}</span>)}</div>
        </article>
      ))}
    </div>
  </div>
</section>
