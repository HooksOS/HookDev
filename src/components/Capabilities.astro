---
import { capabilities } from '../data/site';
---
<section class="band" id="capabilities" aria-labelledby="cap-h">
  <div class="shell">
    <div class="section-head">
      <div class="point"><span class="eyebrow">Capabilities</span></div>
      <h2 id="cap-h">Hooks we build.</h2>
      <p class="sub">Each capability attaches at a specific point in the pool lifecycle — the callback is the contract's entry point.</p>
    </div>

    <div class="cap-grid">
      {capabilities.map((c) => (
        <div class="cap">
          <div class="hook">{c.hook}()</div>
          <div class="body">
            <div class="h">{c.name}</div>
            <div class="d">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
