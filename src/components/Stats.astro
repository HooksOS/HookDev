---
import { stats } from '../data/site';
---
<section class="band" aria-label="Key stats">
  <div class="shell">
    <div class="stats">
      {stats.map((st) => (
        <div class="stat">
          <div class="v">{st.v}</div>
          <div class="l">{st.l}</div>
        </div>
      ))}
    </div>
  </div>
</section>
