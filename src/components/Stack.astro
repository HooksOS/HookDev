---
import { stack } from '../data/site';
---
<section class="band" aria-labelledby="stack-h">
  <div class="shell">
    <div class="section-head">
      <div class="point"><span class="eyebrow">Stack</span></div>
      <h2 id="stack-h">Built with.</h2>
    </div>
    <div class="stack">
      {stack.map((t) => <span>{t}</span>)}
    </div>
  </div>
</section>
