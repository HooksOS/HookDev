---
import { faqs } from '../data/site';
---
<section class="band" id="faq" aria-labelledby="faq-h">
  <div class="shell">
    <div class="section-head">
      <div class="point"><span class="eyebrow">FAQ</span></div>
      <h2 id="faq-h">Common questions.</h2>
    </div>

    <div class="faqs">
      {faqs.map((f) => (
        <div class="faq">
          <div class="q">{f.q}</div>
          <div class="a">{f.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>
