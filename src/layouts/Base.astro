---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HookDev — Uniswap V4 Hook Studio',
  description = 'HookDev is a Web3 development studio shipping five products and custom Uniswap V4 hooks — from dynamic fees to fully programmable pools.',
} = Astro.props;

const ogImage = 'https://hookdev.xyz/design_handoff_hookdev/social-assets/hookdev-facebook-820x312.png';
const favicon = 'design_handoff_hookdev/social-assets/hookdev-avatar-ink-400.png';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A0B0D" />
  <link rel="canonical" href="https://hookdev.xyz/" />

  <!-- Open Graph / social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://hookdev.xyz/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="We build the hooks that power onchain markets." />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@hookdev" />

  <link rel="icon" href={favicon} />
  <link rel="apple-touch-icon" href={favicon} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <slot />
</body>
</html>
